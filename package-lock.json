{
  "name": "pascaal-hallmark-workspace",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "pascaal-hallmark-workspace",
      "version": "0.0.0",
      "license": "Apache-2.0",
      "workspaces": [
        "packages/*",
        "examples/*"
      ],
      "engines": {
        "node": ">=18"
      }
    },
    "examples/provider-demo": {
      "name": "@pascaal/provider-demo",
      "version": "0.1.0",
      "license": "Apache-2.0",
      "dependencies": {
        "@pascaal/barricade": "0.1.0",
        "@pascaal/freeroam": "0.1.0",
        "@pascaal/hallmark": "0.1.0"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "node_modules/@pascaal/barricade": {
      "resolved": "packages/barricade",
      "link": true
    },
    "node_modules/@pascaal/freeroam": {
      "resolved": "packages/freeroam",
      "link": true
    },
    "node_modules/@pascaal/hallmark": {
      "resolved": "packages/hallmark-core",
      "link": true
    },
    "node_modules/@pascaal/provider-demo": {
      "resolved": "examples/provider-demo",
      "link": true
    },
    "packages/barricade": {
      "name": "@pascaal/barricade",
      "version": "0.1.0",
      "license": "Apache-2.0",
      "dependencies": {
        "@pascaal/freeroam": "0.1.0",
        "@pascaal/hallmark": "0.1.0"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "packages/freeroam": {
      "name": "@pascaal/freeroam",
      "version": "0.1.0",
      "license": "Apache-2.0",
      "dependencies": {
        "@pascaal/hallmark": "0.1.0"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "packages/hallmark-core": {
      "name": "@pascaal/hallmark",
      "version": "0.1.0",
      "license": "Apache-2.0",
      "bin": {
        "hallmark": "src/cli.js"
      },
      "engines": {
        "node": ">=18"
      }
    }
  }
}
